--- a/src/slug.mjs
+++ b/src/slug.mjs
@@ -0,0 +1,9 @@
+// Lowercase ASCII slug: accents stripped, runs of characters outside [a-z0-9] plus `keep` become "-".
+export function slugify(text, keep = "") {
+  return text
+    .normalize("NFKD")
+    .replace(/[̀-ͯ]/g, "")
+    .toLowerCase()
+    .replace(new RegExp(`[^a-z0-9${keep}]+`, "g"), "-")
+    .replace(/^-+|-+$/g, "");
+}
