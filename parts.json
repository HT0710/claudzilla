{
  "core": {
    "links": ["CLAUDE.md", "RTK.md", "rules", "hooks/rules-guard.mjs", "hooks/trace.mjs", "hooks/trace.pl", "hooks/md-display.pl", "skills/pr", "skills/rule-review"],
    "hooks": ["rules-guard.mjs", "trace.mjs", "md-display.pl", "rule-review/scan.mjs"],
    "keys": ["env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS", "extraKnownMarketplaces.claude-plugins-official"],
    "plugins": ["superpowers@claude-plugins-official"],
    "rest": true
  },
  "hud": {
    "links": ["hud", "themes"],
    "keys": ["statusLine", "theme", "env.COLORTERM", "env.CLAUDE_CODE_TMUX_TRUECOLOR"]
  },
  "rtk": { "hooks": ["rtk hook claude"] },
  "caveman": {
    "keys": ["env.CAVEMAN_DEFAULT_MODE", "extraKnownMarketplaces.caveman"],
    "plugins": ["caveman@caveman"]
  },
  "ponytail": {
    "keys": ["env.PONYTAIL_DEFAULT_MODE", "extraKnownMarketplaces.ponytail"],
    "plugins": ["ponytail@ponytail"]
  },
  "dividers": { "plugins": ["folio@claudzilla"] },
  "panel": { "plugins": ["margin@claudzilla"] },
  "picks": { "plugins": ["ballot@claudzilla"] },
  "toast": { "plugins": ["herald@claudzilla"] },
  "attribution": { "plugins": ["byline@claudzilla"] },
  "ledger": { "plugins": ["ledger@claudzilla"] },
  "updater": { "plugins": ["primer@claudzilla"], "links": ["hooks/claudzilla-update.sh", "skills/claudzilla-report", "skills/claudzilla-compact"], "hooks": ["claudzilla-update.sh"] }
}
